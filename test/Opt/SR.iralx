define @fn_add i16 i16 i16
    ass     i16             %0      10
    ass     i16             %1      20
    
    mul     i16             %2      %0      2

    mul     i16             %3      %0      8
    div     i16             %4      %0      16
    
    add     i16             %5      %0      1
    sub     i16             %6      %0      1

    ass     i16             &0      %5
    ret