define @fn_add i16 i16 i16
    add     i16             %0      10      20
    sub     i16             %1      10      20
    
    mul     i16             %2      10      20
    div     i16             %3      10      20
    
    neg     i16             %4      10
    inc     i16             %5      10
    dec     i16             %6      10
    not     i16             %7      10
    
    and     i16             %8      10      20
    or      i16             %9      10      20
    xor     i16             %10     10      20
    shl     i16             %11     10      20
    shr     i16             %12     10      20

    ass     i16             &0      %0
    ret