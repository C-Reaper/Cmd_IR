define @fn_add i16 i16 i16
    ass     i16             %0      10
    ass     i16             %1      20
    add     i16             %2      %0      %1

    add     i16             %3      10      20
    add     i16             %4      %0      %1
    add     i16             %5      %3      %4
    add     i16             %6      %2      %5
    
    ass     i16             &0      %6
    ret