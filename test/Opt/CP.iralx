define @fn_add i16 i16 i16
    add     i16             %0      10      10
    sub     i16             %1      %0      20
    
    mul     i16             %2      %1      30
    div     i16             %3      %2      40
    
    neg     i16             %4      %3
    inc     i16             %5      %4
    dec     i16             %6      %5
    not     i16             %7      %6
    
    and     i16             %8      %7      %6
    or      i16             %9      %8      %7
    xor     i16             %10     %9      %8
    shl     i16             %11     %10     %9
    shr     i16             %12     %11     %10

    ass     i16             &0      %12
    ret