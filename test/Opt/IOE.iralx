define @fn_add i16 i16 i16
    ass     i16             %0      1
    ass     i16             %1      2
    ass     i16             %2      3

    ass     i16             %2      %2

    add     i16             %3      %0      0
    sub     i16             %4      %0      0
    mul     i16             %5      %0      1
    div     i16             %6      %0      1

    add     i16             %3      %3      0
    sub     i16             %4      %4      0
    mul     i16             %5      %5      1
    div     i16             %6      %6      1

    add     i16             %3      %3      %3
    sub     i16             %4      0       %4
    mul     i16             %5      %5      0
    div     i16             %6      %6      0

    ass     i16             %5      0
    ass     i16             %6      0

    ass     i16             &0      %3
    ret