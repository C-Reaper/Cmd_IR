global i16 @main i16 i16
    add     i16             %0      &1      &2
    jmp     l_0
    
    tar     l_0
    add     i16             %1      &1      &2
    jmp     l_1
    
    tar     l_1
    add     i16             %2      &1      &2
    jmp     l_2

    tar     l_2
    add     i16             %3      &1      &2
    jmp     l_3

    tar     l_3
    add     i16             %4      %1      %2
    ret     %4