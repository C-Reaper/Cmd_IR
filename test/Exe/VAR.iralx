extern @i16_println i16
extern @println ..

define @fn_add i16 i16 i16
    add     i16             &0      &1      &2
    ret

global @main i16
    ass     i16             %0      2
    ass     i16             %1      1
    add     i16             %2      %0      %1

    alloca  i16             %a
    ass     i16             %a      %0
    add     i16             %3      %a      %1
    destroy %a

    ;store   i16             %a      %2
    ;load    i16             %3      %a

    ass     i16             &0      %3
    ret