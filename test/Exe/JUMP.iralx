define @fn_sub i16 i16 i16
    jmp     label_0
    ass     i16             &0      %0
    tar     label_0
    jmp     label_2
    tar     label_2
    add     i16             %0      &1      &2
    ass     i16             &0      %0
    ret

define @fn_add i16 i16 i16
    sub     i16             %0      &1      &2
    brc     %0              l_0     l_1
    tar     l_0
    add     i16             %1      &1      &2
    jmp     l_2
    tar     l_1
    add     i16             %2      &1      &2
    jmp     l_2
    tar     l_2
    add     i16             %3      %1      %2
    ass     i16             &0      %3
    ret